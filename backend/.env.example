# ==============================================================================
# Team COLLO Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local development.
# Never commit real credentials, passwords, or production secrets to Git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated list of client URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Database Configuration (PostgreSQL 18 with synchronous psycopg 3 driver)
# Default for local development with Postgres.app (trusts local user, no password required):
DATABASE_URL=postgresql+psycopg://localhost:5432/teamcollo

# If your PostgreSQL setup requires custom username/password authentication:
# DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/teamcollo

# ==============================================================================
# Security & JWT Authentication Configuration
# ==============================================================================
# In production, specify a secure cryptographically random secret string.
# Generate one via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
